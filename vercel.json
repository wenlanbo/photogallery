{
  "version": 2,
  "builds": [
    {
      "src": "server.js",
      "use": "@vercel/node"
    },
    {
      "src": "index.html",
      "use": "@vercel/static"
    },
    {
      "src": "styles.css",
      "use": "@vercel/static"
    },
    {
      "src": "script.js",
      "use": "@vercel/static"
    },
    {
      "src": "new-day-one.html",
      "use": "@vercel/static"
    },
    {
      "src": "new-day-one.css",
      "use": "@vercel/static"
    },
    {
      "src": "new-day-one.js",
      "use": "@vercel/static"
    },
    {
      "src": "new-day-one-test.html",
      "use": "@vercel/static"
    },
    {
      "src": "search-covers.html",
      "use": "@vercel/static"
    },
    {
      "src": "debug-api.html",
      "use": "@vercel/static"
    },
    {
      "src": "new-day-one-simple.html",
      "use": "@vercel/static"
    },
    {
      "src": "icons/**",
      "use": "@vercel/static"
    },
    {
      "src": "images/**",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "/server.js"
    },
    {
      "src": "/",
      "dest": "/index.html"
    },
    {
      "src": "/new-day-one",
      "dest": "/new-day-one.html"
    },
    {
      "src": "/new-day-one-test",
      "dest": "/new-day-one-test.html"
    },
    {
      "src": "/search-covers",
      "dest": "/search-covers.html"
    },
    {
      "src": "/debug-api",
      "dest": "/debug-api.html"
    },
    {
      "src": "/new-day-one-simple",
      "dest": "/new-day-one-simple.html"
    },
    {
      "src": "/icons/(.*)",
      "dest": "/icons/$1"
    },
    {
      "src": "/images/(.*)",
      "dest": "/images/$1"
    },
    {
      "src": "/sw.js",
      "dest": "/404.html"
    },
    {
      "src": "/(.*)",
      "dest": "/$1"
    }
  ]
} 