{
  "version": 2,
  "builds": [
    {
      "src": "server.js",
      "use": "@vercel/node"
    },
    {
      "src": "api/frame.js",
      "use": "@vercel/node"
    },
    {
      "src": "api/frame-handler.js",
      "use": "@vercel/node"
    },
    {
      "src": "index.html",
      "use": "@vercel/static"
    },
    {
      "src": "styles.css",
      "use": "@vercel/static"
    },
    {
      "src": "script.js",
      "use": "@vercel/static"
    },
    {
      "src": "new-day-one.html",
      "use": "@vercel/static"
    },
    {
      "src": "frame.html",
      "use": "@vercel/static"
    },
    {
      "src": "test-frame.html",
      "use": "@vercel/static"
    },
    {
      "src": "simple-test.html",
      "use": "@vercel/static"
    },
    {
      "src": "frame-og.png",
      "use": "@vercel/static"
    },
    {
      "src": "app-icon.png",
      "use": "@vercel/static"
    },
    {
      "src": "screenshot1.png",
      "use": "@vercel/static"
    },
    {
      "src": "icons/**",
      "use": "@vercel/static"
    },
    {
      "src": "images/**",
      "use": "@vercel/static"
    },
    {
      "src": ".well-known/**",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/api/frame",
      "dest": "/api/frame.js"
    },
    {
      "src": "/api/frame-handler",
      "dest": "/api/frame-handler.js"
    },
    {
      "src": "/api/(.*)",
      "dest": "/server.js"
    },
    {
      "src": "/.well-known/farcaster.json",
      "dest": "/.well-known/farcaster.json"
    },
    {
      "src": "/",
      "dest": "/index.html"
    },
    {
      "src": "/new-day-one",
      "dest": "/new-day-one.html"
    },
    {
      "src": "/frame",
      "dest": "/frame.html"
    },
    {
      "src": "/test-frame",
      "dest": "/test-frame.html"
    },
    {
      "src": "/simple-test",
      "dest": "/simple-test.html"
    },
    {
      "src": "/images/(.*)",
      "dest": "/images/$1"
    },
    {
      "src": "/icons/(.*)",
      "dest": "/icons/$1"
    },
    {
      "src": "/sw.js",
      "dest": "/404.html"
    },
    {
      "src": "/(.*)",
      "dest": "/$1"
    }
  ]
} 